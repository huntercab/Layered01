
root = true

# General text-file rules
[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

# C# formatting
[*.cs]
indent_style = space
indent_size = 4
tab_width = 4

# ============================================================
# Using statements
# ============================================================

# System namespaces must appear before application namespaces.
dotnet_sort_system_directives_first = true

# Do not require an empty line between System and other namespaces.
dotnet_separate_import_directive_groups = false

# Usings must be outside the namespace declaration.
csharp_using_directive_placement = outside_namespace:error

# IDE0055 includes formatting and using-order validation.
dotnet_diagnostic.IDE0055.severity = error

# Remove unused using statements.
dotnet_diagnostic.IDE0005.severity = error

# Enforce using placement.
dotnet_diagnostic.IDE0065.severity = error

# ============================================================
# Basic C# style
# ============================================================

# Always use braces for if, else, for, foreach, while, and so on.
csharp_prefer_braces = true:error

# Prefer file-scoped namespaces.
csharp_style_namespace_declarations = file_scoped:error

# Fields that are never reassigned should be readonly.
dotnet_style_readonly_field = true:error

# Prefer explicit types unless the assigned expression makes the type obvious.
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Do not unnecessarily qualify members with this.
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# Prefer object and collection initializers.
dotnet_style_object_initializer = true:error
dotnet_style_collection_initializer = true:error

# Prefer pattern matching for null checks.
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:error

#Allow implicit types var
dotnet_diagnostic.IDE0008.severity = none

dotnet_diagnostic.CA1848.severity = none
# ============================================================
# Naming: interfaces must start with I
# ============================================================

dotnet_naming_rule.interfaces_must_start_with_i.severity = error
dotnet_naming_rule.interfaces_must_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_must_start_with_i.style = interface_style

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *

dotnet_naming_style.interface_style.required_prefix = I
dotnet_naming_style.interface_style.capitalization = pascal_case

# ============================================================
# Naming: types use PascalCase
# ============================================================

dotnet_naming_rule.types_must_use_pascal_case.severity = error
dotnet_naming_rule.types_must_use_pascal_case.symbols = types
dotnet_naming_rule.types_must_use_pascal_case.style = pascal_case_style

dotnet_naming_symbols.types.applicable_kinds = class, struct, enum, delegate
dotnet_naming_symbols.types.applicable_accessibilities = *

dotnet_naming_style.pascal_case_style.capitalization = pascal_case

# ============================================================
# Additional checks not enabled by default
# ============================================================

# CA1502: Reject excessively complex methods.
dotnet_diagnostic.CA1502.severity = warning

# MA0032: Prefer overloads that accept CancellationToken.
dotnet_diagnostic.MA0032.severity = warning

# MA0155: Do not use async void methods.
dotnet_diagnostic.MA0155.severity = warning

# ============================================================
# Generated files
# ============================================================

[*.Designer.cs]
generated_code = true

[**/Migrations/*.cs]
generated_code = true