#!/usr/bin/env bash

set -euo pipefail

echo "Running pre-push validation..."

REPOSITORY_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPOSITORY_ROOT"

# Git Bash may not inherit the same PATH as PowerShell or Visual Studio.
export PATH="/c/Program Files/dotnet:$PATH"

if command -v dotnet >/dev/null 2>&1; then
    DOTNET="dotnet"
elif [[ -x "/c/Program Files/dotnet/dotnet.exe" ]]; then
    DOTNET="/c/Program Files/dotnet/dotnet.exe"
else
    echo "ERROR: The .NET SDK could not be found."
    echo "Expected location: C:\\Program Files\\dotnet\\dotnet.exe"
    exit 1
fi

echo "Using .NET SDK:"
"$DOTNET" --version

# Add or modify solution paths here.
SOLUTIONS=(
    "LayeredArchitecture.slnx"
)

# These rules remain warnings in .editorconfig, but are treated as errors
# only during pre-push validation.
VALIDATED_WARNINGS="IDE0005;IDE0055;IDE0065;CA1502;MA0032;MA0155"

for solution in "${SOLUTIONS[@]}"; do
    if [[ ! -f "$solution" ]]; then
        echo "ERROR: Solution not found: $solution"
        exit 1
    fi

    echo ""
    echo "Restoring $solution..."
    "$DOTNET" restore "$solution" --nologo

    echo "Checking formatting for $solution..."
    "$DOTNET" format "$solution" \
        --verify-no-changes \
        --severity info \
        --no-restore \
        --verbosity minimal

    echo "Checking analyzer rules for $solution..."
    "$DOTNET" build "$solution" \
        --configuration Release \
        --no-restore \
        --nologo \
        "-warnaserror:$VALIDATED_WARNINGS"
done

echo ""
echo "Pre-push validation succeeded."
exit 0